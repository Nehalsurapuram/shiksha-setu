// ShikshaSetu AI - Phase 1 data model
// MTB-MLE Teacher Assistant. Initial pair: Hindi (hi-IN) -> Santhali (sat-IN).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum UserRole {
  TEACHER
  HEAD_TEACHER
  COORDINATOR
  /// Validates teachers' corrections. The only role whose approval can mark a
  /// translation or a glossary term verified.
  LANGUAGE_EXPERT
  ADMIN
}

enum LanguageStatus {
  ACTIVE
  PLANNED
  DEPRECATED
}

enum LanguageScript {
  DEVANAGARI
  OL_CHIKI
  LATIN
  ODIA
  BENGALI
}

enum LessonStatus {
  DRAFT
  READY
  ARCHIVED
}

enum TranslationSource {
  SARVAM
  OPENAI
  GLOSSARY
  HUMAN
  DEMO
}

enum ReviewStatus {
  UNREVIEWED
  APPROVED
  CORRECTED
  REJECTED
}

enum AudioKind {
  LESSON_NARRATION
  WORD_PRONUNCIATION
  TEACHER_RECORDING
  TTS_OUTPUT
}

enum AssessmentKind {
  ORAL
  WRITTEN
  PICTURE_BASED
  LISTENING
  MIXED
}

/// The worksheet's overall shape. Individual questions carry their own type
/// inside `content`, so a sheet mixing formats is MIXED rather than being
/// forced into whichever kind happens to appear first.
enum WorksheetKind {
  MATCHING
  FILL_IN_BLANKS
  READING
  PICTURE_LABELLING
  WORD_HUNT
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  COUNTING
  MIXED
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
  CONFLICT
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

// ---------------------------------------------------------------- core

model School {
  id        String   @id @default(cuid())
  name      String
  udiseCode String?  @unique
  village   String?
  block     String?
  district  String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  lessons             Lesson[]
  analyticsEvents     AnalyticsEvent[]
  outcomeObservations OutcomeObservation[]
  classroomSessions   ClassroomSession[]

  @@index([district, block])
  @@index([state])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         UserRole  @default(TEACHER)
  phone        String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // Preferred classroom language pair
  sourceLanguageId String?
  sourceLanguage   Language? @relation("UserSourceLanguage", fields: [sourceLanguageId], references: [id], onDelete: SetNull)
  targetLanguageId String?
  targetLanguage   Language? @relation("UserTargetLanguage", fields: [targetLanguageId], references: [id], onDelete: SetNull)

  lessons             Lesson[]
  translations        Translation[]
  glossaryTerms       GlossaryTerm[]
  worksheets          Worksheet[]
  flashcards          Flashcard[]
  assessments         Assessment[]
  audios              Audio[]
  corrections         TranslationCorrection[]
  reviewedCorrections TranslationCorrection[] @relation("CorrectionReviewer")
  outcomeObservations OutcomeObservation[]
  syncItems           SyncItem[]
  analyticsEvents     AnalyticsEvent[]
  classroomSessions   ClassroomSession[]

  @@index([schoolId])
  @@index([role])
}

model Language {
  id         String         @id @default(cuid())
  code       String         @unique // BCP-47-ish, e.g. hi-IN, sat-IN
  name       String // English name, e.g. "Santhali"
  nativeName String // Endonym in its own script
  script     LanguageScript
  status     LanguageStatus @default(PLANNED)
  direction  String         @default("ltr")
  isSource   Boolean        @default(false) // usable as instruction/source language
  isTarget   Boolean        @default(false) // usable as mother-tongue/target language
  sortOrder  Int            @default(0)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  usersAsSource User[] @relation("UserSourceLanguage")
  usersAsTarget User[] @relation("UserTargetLanguage")

  lessonsAsSource Lesson[] @relation("LessonSourceLanguage")
  lessonsAsTarget Lesson[] @relation("LessonTargetLanguage")

  translationsAsSource Translation[] @relation("TranslationSourceLanguage")
  translationsAsTarget Translation[] @relation("TranslationTargetLanguage")

  glossaryAsSource GlossaryTerm[] @relation("GlossarySourceLanguage")
  glossaryAsTarget GlossaryTerm[] @relation("GlossaryTargetLanguage")

  flashcards Flashcard[]
  audios     Audio[]

  sessionsAsInstruction  ClassroomSession[] @relation("SessionInstructionLanguage")
  sessionsAsMotherTongue ClassroomSession[] @relation("SessionMotherTongue")
  messagesAsSource       ClassroomMessage[] @relation("MessageSourceLanguage")
  messagesAsTarget       ClassroomMessage[] @relation("MessageTargetLanguage")

  @@index([status])
  @@index([isTarget])
}

// ---------------------------------------------------------------- content

model Lesson {
  id               String       @id @default(cuid())
  title            String
  subject          String?
  grade            Int?
  topic            String?
  sourceText       String       @db.Text
  /// The mother-tongue version, when one has been produced.
  translatedText   String?      @db.Text
  /// Provenance of sourceText, so a teacher can see where the words came from:
  /// a PDF text layer, OCR of a photo, a Word file, or typed by hand.
  originalFileName String?
  sourceFormat     String?
  extractionMethod String?
  /// Suggested FLN alignment for this material: plain-language learning area,
  /// competency and outcome produced by a model, never official codes. Null
  /// when no alignment has been generated.
  alignment        Json?
  status           LessonStatus @default(DRAFT)
  isOfflinePinned  Boolean      @default(false)
  /// Seeded demo content, not a teacher's own work. The UI labels these so a
  /// populated-looking dashboard is never mistaken for real classroom history.
  isSample         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  /// When a teacher last opened this lesson. Drives "Continue teaching";
  /// null means it has never been opened.
  lastOpenedAt     DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  sourceLanguageId String
  sourceLanguage   Language @relation("LessonSourceLanguage", fields: [sourceLanguageId], references: [id])
  targetLanguageId String
  targetLanguage   Language @relation("LessonTargetLanguage", fields: [targetLanguageId], references: [id])

  translations        Translation[]
  worksheets          Worksheet[]
  flashcards          Flashcard[]
  assessments         Assessment[]
  audios              Audio[]
  outcomeObservations OutcomeObservation[]
  teachingPackage     TeachingPackage?

  @@index([authorId])
  @@index([schoolId])
  @@index([status])
  @@index([grade, subject])
  @@index([lastOpenedAt])
}

model Translation {
  id           String            @id @default(cuid())
  sourceText   String            @db.Text
  targetText   String            @db.Text
  source       TranslationSource @default(DEMO)
  model        String?
  confidence   Float?
  reviewStatus ReviewStatus      @default(UNREVIEWED)
  contentHash  String // hash of source text + language pair, for dedupe and offline cache lookups
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  sourceLanguageId String
  sourceLanguage   Language @relation("TranslationSourceLanguage", fields: [sourceLanguageId], references: [id])
  targetLanguageId String
  targetLanguage   Language @relation("TranslationTargetLanguage", fields: [targetLanguageId], references: [id])

  corrections       TranslationCorrection[]
  audios            Audio[]
  classroomMessages ClassroomMessage[]

  @@unique([contentHash, sourceLanguageId, targetLanguageId])
  @@index([lessonId])
  @@index([reviewStatus])
  @@index([createdById])
}

/// A human's judgement on one machine translation, and what an expert made of it.
///
/// Two levels, deliberately kept apart:
///   isAccepted — the teacher uses this text in their own classroom. True from
///                the moment they type it; their lesson cannot wait for review.
///   status     — a language expert's verdict. Only APPROVED text may be
///                promoted to a verified glossary term or served to anyone
///                else, because only that has been checked by someone who
///                speaks the mother tongue.
model TranslationCorrection {
  id            String   @id @default(cuid())
  correctedText String   @db.Text
  reason        String?
  isAccepted    Boolean  @default(false)
  createdAt     DateTime @default(now())

  /// What the model produced, copied in when the correction was made.
  /// Snapshotted rather than read back through the relation: the point of a
  /// correction is the difference between the two, and that is lost if the
  /// translation it points at is later re-translated.
  aiTranslation String? @db.Text

  /// The expert's verdict. UNREVIEWED until someone with the role looks.
  status     ReviewStatus @default(UNREVIEWED)
  /// The expert's own wording, when they neither approved nor rejected the
  /// teacher's. Kept separate so the teacher's text is never overwritten.
  expertText String?      @db.Text
  reviewNote String?
  reviewedAt DateTime?

  reviewedById String?
  reviewedBy   User?   @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Set when this correction became a verified glossary term.
  promotedTermId String?

  translationId String
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  correctedById String
  correctedBy   User   @relation(fields: [correctedById], references: [id], onDelete: Cascade)

  @@index([translationId])
  @@index([correctedById])
  @@index([isAccepted])
  @@index([status, createdAt])
}

model GlossaryTerm {
  id                 String   @id @default(cuid())
  sourceTerm         String
  targetTerm         String
  domain             String? // e.g. "science", "maths", "civics"
  partOfSpeech       String?
  notes              String?
  isVerified         Boolean  @default(false)
  /// The approved correction this term came from, when it was promoted rather
  /// than typed in directly. A verified term must be traceable to the person
  /// who approved it.
  sourceCorrectionId String?
  usageCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sourceLanguageId String
  sourceLanguage   Language @relation("GlossarySourceLanguage", fields: [sourceLanguageId], references: [id])
  targetLanguageId String
  targetLanguage   Language @relation("GlossaryTargetLanguage", fields: [targetLanguageId], references: [id])

  @@unique([sourceTerm, sourceLanguageId, targetLanguageId])
  @@index([domain])
  @@index([isVerified])
}

model Worksheet {
  id           String        @id @default(cuid())
  title        String
  kind         WorksheetKind @default(MATCHING)
  grade        Int?
  subject      String?
  topic        String?
  /// "easy" | "medium" | "hard", as chosen by the teacher who generated it.
  difficulty   String?
  instructions String?       @db.Text
  /// Bilingual question payload. Each entry carries its own type and its own
  /// `sat` field, which is null when that string was not translated.
  content      Json
  /// Which provider and model drafted this, and whether a teacher has since
  /// edited it. Null provider means a teacher wrote the whole thing.
  alignment    Json?
  provider     String?
  model        String?
  isEdited     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([createdById])
  @@index([kind])
}

model Flashcard {
  id              String   @id @default(cuid())
  frontText       String
  backText        String
  imageUrl        String?
  /// A single emoji standing in for a picture. No image model is configured,
  /// so this is an icon chosen for the word — never a generated photograph
  /// presented as one.
  icon            String?
  exampleSentence String?  @db.Text
  /// Cards generated together share a deck id, so a saved set can be reopened
  /// as the set it was.
  deckId          String?
  deckTitle       String?
  grade           Int?
  subject         String?
  provider        String?
  model           String?
  isEdited        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  languageId String
  language   Language @relation(fields: [languageId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  audios Audio[]

  @@index([lessonId])
  @@index([languageId])
  @@index([createdById])
  @@index([deckId])
}

model Assessment {
  id         String         @id @default(cuid())
  title      String
  kind       AssessmentKind @default(ORAL)
  grade      Int?
  subject    String?
  topic      String?
  difficulty String?
  /// Bilingual questions, each with its own type and its own correct answer.
  /// The answer key is rendered from this rather than stored twice, so the two
  /// can never drift apart.
  questions  Json
  maxScore   Int            @default(10)
  alignment  Json?
  provider   String?
  model      String?
  isEdited   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  outcomeObservations OutcomeObservation[]

  @@index([lessonId])
  @@index([createdById])
  @@index([kind])
}

model Audio {
  id              String    @id @default(cuid())
  kind            AudioKind @default(TTS_OUTPUT)
  url             String
  transcript      String?   @db.Text
  durationMs      Int?
  mimeType        String    @default("audio/mpeg")
  sizeBytes       Int?
  isOfflineCached Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  languageId String
  language   Language @relation(fields: [languageId], references: [id])

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  translationId String?
  translation   Translation? @relation(fields: [translationId], references: [id], onDelete: SetNull)

  flashcardId String?
  flashcard   Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([languageId])
  @@index([kind])
}

// ---------------------------------------------------------------- outcomes, sync, analytics

/// A single observation of one child's progress: what they were seen to do,
/// and when. This is evidence, not a definition — the definitions live in
/// LearningOutcome.
model OutcomeObservation {
  id          String   @id @default(cuid())
  /// Only ever an official code that came from verified source data. Never a
  /// code produced by a model.
  code        String?
  description String   @db.Text
  grade       Int?
  subject     String?
  score       Float?
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([schoolId])
  @@index([grade, subject])
}

/// Outbox for offline-first clients: local mutations queued on the tablet
/// while it has no connectivity, drained once the device is back online.
model SyncItem {
  id         String        @id @default(cuid())
  deviceId   String
  entityType String // "Lesson", "Translation", ...
  entityId   String
  operation  SyncOperation @default(CREATE)
  status     SyncStatus    @default(PENDING)
  payload    Json
  attempts   Int           @default(0)
  lastError  String?
  clientTime DateTime // when the change happened on the tablet
  syncedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, entityType, entityId, clientTime])
  @@index([userId, status])
  @@index([status, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String // e.g. "translation.requested"
  properties Json?
  deviceId   String?
  isOffline  Boolean  @default(false)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([userId])
  @@index([schoolId])
}

// ---------------------------------------------------------------- classroom

enum ClassroomSpeaker {
  TEACHER
  STUDENT
}

/// A live back-and-forth between a teacher and a student, saved on request.
/// Sessions are the record of what was actually said in a classroom, which is
/// where the evidence for whether this product helps will eventually come from.
model ClassroomSession {
  id        String   @id @default(cuid())
  title     String?
  startedAt DateTime
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  instructionLanguageId String
  instructionLanguage   Language @relation("SessionInstructionLanguage", fields: [instructionLanguageId], references: [id])
  motherTongueId        String
  motherTongue          Language @relation("SessionMotherTongue", fields: [motherTongueId], references: [id])

  messages ClassroomMessage[]

  @@index([teacherId, savedAt])
  @@index([schoolId])
}

model ClassroomMessage {
  id             String           @id @default(cuid())
  speaker        ClassroomSpeaker
  /// What was said, in the speaker's own language.
  sourceText     String           @db.Text
  /// What the other person was shown. Null if translation failed for this turn.
  translatedText String?          @db.Text
  /// Whether audio was actually produced for the translation.
  hadAudio       Boolean          @default(false)
  /// Measured end-to-end time for this turn, in milliseconds.
  latencyMs      Int?
  spokenAt       DateTime
  createdAt      DateTime         @default(now())

  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sourceLanguageId String
  sourceLanguage   Language @relation("MessageSourceLanguage", fields: [sourceLanguageId], references: [id])
  targetLanguageId String
  targetLanguage   Language @relation("MessageTargetLanguage", fields: [targetLanguageId], references: [id])

  translationId String?
  translation   Translation? @relation(fields: [translationId], references: [id], onDelete: SetNull)

  @@index([sessionId, spokenAt])
  @@index([translationId])
}

/// The generated teaching material for a lesson.
///
///  holds the whole editable package as JSON rather than thirty
/// columns: a teacher edits any part of it, and the shape will keep changing as
/// the format is refined.  records that a human has been through it,
/// which matters when judging whether generated text was ever reviewed.
/// The generated teaching material for a lesson.
///
/// `content` holds the whole editable package as JSON rather than thirty
/// columns: a teacher edits any part of it, and the shape will keep changing
/// as the format is refined. `isEdited` records that a human has been through
/// it, which matters when judging whether generated text was ever reviewed.
model TeachingPackage {
  id          String   @id @default(cuid())
  content     Json
  /// Which provider and model produced the first draft. Null once a teacher
  /// has rewritten it enough that attributing it to a model would be wrong.
  provider    String?
  model       String?
  isEdited    Boolean  @default(false)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- FLN alignment

/// A learning-outcome *definition* from a curriculum framework.
///
/// This is a catalogue, not a generated artefact. The whole point of the table
/// is `verifiedSource`: a row with a source came from a real published
/// document that somebody loaded and can be checked against, and a row without
/// one did not.
///
/// This installation ships with the table EMPTY. No NIPUN Bharat or NCERT
/// mapping has been loaded, so nothing in the product may present itself as
/// official alignment. Generated alignments are labelled "Suggested FLN
/// Alignment" and are never written here.
model LearningOutcome {
  id             String   @id @default(cuid())
  /// e.g. "Foundational Literacy", "Foundational Numeracy".
  learningArea   String
  competency     String   @db.Text
  outcome        String   @db.Text
  /// The class this outcome belongs to. Null means it spans several.
  classLevel     Int?
  subject        String?
  /// Citation for where this came from — a document title, edition and page,
  /// or a URL. NULL MEANS UNVERIFIED, and the UI must say so. Nothing written
  /// by a model may ever set this field.
  verifiedSource String?
  /// The framework's own code, only ever copied from verified source data.
  /// Never generated, never inferred.
  code           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([learningArea, competency, outcome, classLevel])
  @@index([classLevel, subject])
  @@index([verifiedSource])
}
