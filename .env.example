# ShikshaSetu AI - environment template
# Copy to .env and fill in real values. Never commit .env.
# Nothing here is a NEXT_PUBLIC_ variable: every value below is server-only.

# --- AI / translation providers -------------------------------------------
SARVAM_API_KEY=
OPENAI_API_KEY=

# --- Database --------------------------------------------------------------
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Required. Signs session tokens: openssl rand -base64 32
AUTH_SECRET=
# Only needed when the deployment URL cannot be inferred (e.g. behind a proxy).
AUTH_URL=
# Seed only: the password given to the demo accounts by `npm run db:seed`.
# Never used at runtime. Leave blank in any real deployment.
SEED_PASSWORD=

# --- Provider selection ----------------------------------------------------
TRANSLATION_PROVIDER=sarvam
# openai (needs OPENAI_API_KEY with credit) or sarvam (reuses SARVAM_API_KEY)
LLM_PROVIDER=openai

# --- Feature flags ---------------------------------------------------------
# Demo mode keeps every AI feature clearly labelled as not-yet-implemented
# instead of returning invented translations. Keep true until Phase 2.
ENABLE_DEMO_MODE=true
